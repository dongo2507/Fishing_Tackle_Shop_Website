<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="fishingPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.fishing.model.Category</class>
        <class>com.fishing.model.Brand</class>
        <class>com.fishing.model.Product</class>
        <class>com.fishing.model.ProductImage</class>
        <class>com.fishing.model.Feedback</class>
        <class>com.fishing.model.SubFeedback</class>
        <class>com.fishing.model.Notification</class>
        <!-- Customer, Address va Admin -->
        <class>com.fishing.model.Customer</class>
        <class>com.fishing.model.Admin</class>
        <class>com.fishing.model.Address</class>

        <!-- Gio hang va Don hang -->
        <class>com.fishing.model.Cart</class>
        <class>com.fishing.model.CartItem</class>
        <class>com.fishing.model.Order</class>
        <class>com.fishing.model.LineItem</class>

        <!-- Thanh toan va Van chuyen -->
        <class>com.fishing.model.Payment</class>
        <class>com.fishing.model.Shipping</class>
        
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/fishing_shop"/>
            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>
            <property name="jakarta.persistence.jdbc.password"
                      value="Namnhat28022008"/>

            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.poolName"
                      value="FishingShopPool"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>
            <property name="hibernate.hikari.connectionTimeout" value="30000"/>
            <property name="hibernate.hikari.idleTimeout" value="600000"/>
            <property name="hibernate.hikari.maxLifetime" value="1800000"/>
            
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
